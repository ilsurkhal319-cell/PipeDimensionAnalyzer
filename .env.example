OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.vsegpt.ru/v1
OPENAI_MODEL=openai/gpt-5.4-nano

# Optional: current API prices in USD per one million tokens.
# Set these on the day of the final measured run.
OPENAI_INPUT_USD_PER_MTOK=0.20
OPENAI_OUTPUT_USD_PER_MTOK=1.25
VSEGPT_INPUT_RUB_PER_KTOK=0.06
VSEGPT_OUTPUT_RUB_PER_KTOK=0.35
